{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cursiv",
  "version": "1.18.0",
  "identifier": "fr.djaelmola.cursiv",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cursiv",
        "width": 1240,
        "height": 840,
        "minWidth": 520,
        "minHeight": 380,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: http://asset.localhost https://fonts.googleapis.com https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' asset: http://asset.localhost data: blob: https: http:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' data: https://fonts.gstatic.com https://cdn.jsdelivr.net; connect-src 'self' ipc: http://ipc.localhost https://api.github.com https://github.com https://objects.githubusercontent.com https:;",
      "capabilities": ["default"],
      "assetProtocol": {
        "enable": true,
        "scope": ["$DOCUMENT/**", "$HOME/**", "$APPDATA/**", "$LOCALAPPDATA/**", "$TEMP/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerHooks": "installerHooks.nsh",
        "installMode": "currentUser",
        "compression": "lzma",
        "languages": ["French", "English"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "windows": {
        "installMode": "passive"
      },
      "endpoints": [
        "https://github.com/djael-ml/cursiv/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUyQzM1Q0VBODMzRkU1NjcKUldSbjVUK0Q2bHpEVWwraDdqNmp3dy9pQXhCcEljN3M3aVRnUGhOK25vdTcxOThSUDVZZ2QyWlgK"
    }
  }
}
